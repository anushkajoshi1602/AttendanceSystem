# AttendEase Frontend Environment Template
# Copy this file to .env and adjust values as needed.

# Base URL of the Java Spring Boot REST API (no trailing slash)
# Local development:  http://localhost:8080/api
# Production (Render): https://attendease-api-kohh.onrender.com/api
VITE_API_BASE_URL=http://localhost:8080/api

# Data mode toggle:
# false = connect to live backend API at VITE_API_BASE_URL (persists to MySQL)
# true  = use in-browser memory sample data (preview only, no database required)
VITE_USE_SAMPLE_DATA=false
